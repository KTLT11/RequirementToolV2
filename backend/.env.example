# Copy this file to .env.local (already gitignored via *.local) and
# fill in real values. Never commit the filled-in file.

PGHOST=aws-0-ap-southeast-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
# Supabase's pooler (Supavisor) routes by tenant using the username,
# so it must be "<role>.<project_ref>", not just the bare role name -
# a plain "app_backend" fails with ENOIDENTIFIER ("no tenant
# identifier provided"). Find <project_ref> in supabase/config.toml
# (project_id) or the Dashboard connection string.
PGUSER=app_backend.<project_ref>
PGPASSWORD=

# Required for both the direct host (db.<project>.supabase.co) and
# the pooler host (*.pooler.supabase.com, used by default here) —
# both present a certificate signed by Supabase's own CA, not one in
# Node's default trust store. Download it from Project Settings ->
# Database -> SSL Configuration.
PGSSLROOTCERT=./certs/prod-ca-2021.crt

# The frontend's exact origin. Must be a single explicit value, never
# "*" — the session cookie is credentialed, and a wildcard origin is
# both rejected by browsers for credentialed requests and defeats the
# purpose of an HttpOnly cookie if left open to any origin.
CORS_ORIGIN=http://localhost:5173

PORT=3000
